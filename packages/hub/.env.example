# Hub configuration. Copy to .env or set in the environment. NEVER commit secrets.

# Shared secret sessions present to register (must equal the channel's
# TELEGRAM_HUB_SECRET). Required.
HUB_SESSION_SECRET=change-me

# Comma-separated platform user ids allowed to talk to the hub; unknown senders
# are dropped. Required (>= 1).
HUB_ALLOWLIST=123456789

# Comma-separated group room ids the hub operates in. Optional (DM-only if empty).
# HUB_ROOMS=-1001234567890

# Which transport adapter to load. "loopback" (dev/test) today; "telegram" lands
# in Stage 3.
HUB_ADAPTER=loopback

# Session-facing WS/HTTP bind address. Use 0.0.0.0 for a container/remote hub and
# put auth/TLS in front of it; 127.0.0.1 is the safe co-located default.
# HUB_BIND_HOST=127.0.0.1
# HUB_BIND_PORT=8787

# Loop governor (Stage 5) and routing knobs.
# HUB_HOP_BUDGET=6
# HUB_TAG_SIGIL=@
# HUB_LOG_LEVEL=info

# Presence notices: announce "@agent online/offline" in HUB_ROOMS. Off by
# default (opt-in room traffic); needs at least one HUB_ROOMS entry to post.
# HUB_PRESENCE=off
# Grace window (ms) a dropped session may reconnect within before it's announced
# offline — absorbs restart churn so presence doesn't flap.
# HUB_PRESENCE_GRACE_MS=10000

# --- telegram adapter (Stage 3) ---
# TELEGRAM_BOT_TOKEN=
