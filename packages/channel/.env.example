# Thin channel configuration (per-session). Copy to .env or export in the
# session's environment. NEVER commit real secrets.

# Hub URL this session connects to (local or remote). Required.
TELEGRAM_HUB_URL=ws://127.0.0.1:8787

# Shared secret; must match the hub's HUB_SESSION_SECRET. Required.
TELEGRAM_HUB_SECRET=change-me

# Logical agent name for this session. Optional; defaults to the working-dir basename.
# TELEGRAM_HUB_AGENT=re-infra

# Optional tuning.
# TELEGRAM_HUB_LOG_LEVEL=info
# TELEGRAM_HUB_RECONNECT_INITIAL_MS=500
# TELEGRAM_HUB_RECONNECT_MAX_MS=15000
