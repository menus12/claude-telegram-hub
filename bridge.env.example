# Cloud bridge settings for docker-compose.bridge.yml (copy to bridge.env, gitignored).
# Used for compose interpolation (--env-file bridge.env). See docs/cloud-agents.md.

# Room for join/leave notices and a cloud agent's first `send` (the hub's room id).
BRIDGE_DEFAULT_ROOM=
# Hashed per-environment bearer tokens: `label sha256hex` per line (0600, uid 1000).
BRIDGE_TOKENS_PATH=/home/srvteam/.config/claude-telegram-hub/bridge-tokens
# Tunnel token from the network owner (raw token, 0600, uid 1000).
TUNNEL_TOKEN_PATH=/home/srvteam/.config/claude-telegram-hub/hub-bridge-<project>.tunnel-token
# Optional:
# BRIDGE_IMAGE=ghcr.io/menus12/claude-telegram-hub:v0.16.0
# BRIDGE_RUN_AS=1000:1000
# BRIDGE_MAX_AGENTS_PER_TOKEN=5
# BRIDGE_LOG_LEVEL=info
