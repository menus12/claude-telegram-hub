{
  "name": "claude-telegram-hub",
  "version": "0.0.0",
  "private": true,
  "description": "Drive interactive Claude Code sessions from Telegram — always-on hub + thin channel plugin",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.16.11",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.9.0",
    "vitest": "^2.1.3"
  }
}
